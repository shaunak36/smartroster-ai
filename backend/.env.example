# Relative SQLite paths are resolved from this backend directory.
BACKEND_DATABASE_URL=sqlite:///./smartroster.db
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
BACKEND_APP_NAME=SmartRoster AI API
BACKEND_DEBUG=false
BACKEND_ENVIRONMENT=development
BACKEND_AUTH_SECRET=replace-with-at-least-32-random-characters
BACKEND_AUTH_ISSUER=smartroster-ai
BACKEND_AUTH_AUDIENCE=smartroster-api
BACKEND_ACCESS_TOKEN_MINUTES=30
BACKEND_BOOTSTRAP_ADMIN_TOKEN=replace-with-a-long-one-time-bootstrap-token
